# GitHub Personal Access Token used for authenticated GraphQL/REST calls.
# Fine-grained PAT with public read scope is sufficient. Create at:
#   https://github.com/settings/tokens?type=beta
# Required scopes: read-only access to public repository metadata.
GITHUB_TOKEN=""

# Public base URL of the deployed app, used in card footers and OG metadata.
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_BASE_URL=""
