# GitHub Personal Access Token — the SHARED APP TOKEN (anonymous front-line
# + mercy-ladder fallback). Fine-grained PAT with public read scope is
# sufficient. Create at: https://github.com/settings/tokens?type=beta
# IMPORTANT: never paste a real token here — this file is committed.
# Put real values in .env.local (which is gitignored).
GITHUB_TOKEN=""

# Public base URL of the deployed app, used in card footers and OG metadata.
# Defaults to http://localhost:3000 in development.
NEXT_PUBLIC_BASE_URL=""

# ─── Auth foundation (Wave 1) ─────────────────────────────────────────

# Neon Postgres (Vercel Marketplace). Pooled URL for runtime (edge-safe
# @neondatabase/serverless HTTP driver); unpooled/direct URL for migrations.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Upstash Redis (Vercel Marketplace). REST creds — edge-safe. Carries the
# L2 data cache + usage counters + single-flight locks.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Better Auth. Secret = 32+ random bytes (`openssl rand -base64 32`).
# URL = the app base URL per environment.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth App (NEW — separate from GITHUB_TOKEN). Primary private-data
# path. Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# PAT vault envelope-encryption master key — 32 bytes, base64
# (`openssl rand -base64 32`). SECRET; distinct per environment; never
# commit. key_version lets us rotate/upgrade to a KMS without re-encrypting.
PAT_ENC_KEY=""
PAT_ENC_KEY_VERSION="1"
